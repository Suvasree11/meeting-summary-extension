{
  "manifest_version": 3,
  "name": "MeetMind Capture",
  "version": "1.0.0",
  "description": "One-click meeting tab audio capture for MeetMind.",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://meeting-summary-black.vercel.app/*",
    "http://127.0.0.1/*",
    "https://meet.google.com/*",
    "https://www.loom.com/*",
    "https://loom.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://meeting-summary-black.vercel.app/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://www.loom.com/*",
        "https://loom.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "meeting-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MeetMind Capture"
  }
}